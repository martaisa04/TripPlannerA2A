{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "TripPlannerA2A",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "TripPlannerA2A"
  },
  "runtimes": [
    {
      "name": "FlightsAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/FlightsAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "A2A"
    },
    {
      "name": "WeatherAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/WeatherAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "A2A"
    },
    {
      "name": "ReservationsAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ReservationsAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "envVars": [
        {
          "name": "RESERVATIONS_API_URL",
          "value": "https://e65dfdudm0.execute-api.us-east-2.amazonaws.com"
        }
      ]
    },
    {
      "name": "OrchestratorAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/OrchestratorAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "FLIGHTS_AGENT_URL",
          "value": "https://bedrock-agentcore.us-east-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-2%3A700002441872%3Aruntime%2FTripPlannerA2A_FlightsAgent-r74L5a3eom/invocations/"
        },
        {
          "name": "WEATHER_AGENT_URL",
          "value": "https://bedrock-agentcore.us-east-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-2%3A700002441872%3Aruntime%2FTripPlannerA2A_WeatherAgent-iEXKh9AfuB/invocations/"
        },
        {
          "name": "RESERVATIONS_AGENT_URL",
          "value": "https://bedrock-agentcore.us-east-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-2%3A700002441872%3Aruntime%2FTripPlannerA2A_ReservationsAgent-B4LW9YANsi/invocations/"
        },
        {
          "name": "TRIP_MEMORY_ID",
          "value": "TripPlannerA2A_TripPlannerMemory-H6Sp3R8Duc"
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "TripPlannerMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "name": "TravelerPreferences",
          "description": "Preferencias de viaje del usuario (horarios, aerolíneas, asientos).",
          "namespaceTemplates": ["/preferences/{actorId}/"]
        },
        {
          "type": "SUMMARIZATION",
          "name": "SessionSummarizer",
          "description": "Resumen por sesión de planificación de viaje.",
          "namespaceTemplates": ["/summaries/{actorId}/{sessionId}/"]
        },
        {
          "type": "SEMANTIC",
          "name": "TravelFacts",
          "description": "Hechos relevantes del viaje recuperables por significado.",
          "namespaceTemplates": ["/facts/{actorId}/"]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [
    {
      "name": "MyHarness",
      "path": "app/MyHarness"
    }
  ],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}