# Copiar a .env.local y completar con los valores reales tras agentcore deploy

# URL del OrchestratorAgent en Bedrock AgentCore (HTTP invoke endpoint)
VITE_ORCHESTRATOR_URL=https://bedrock-agentcore.us-east-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-2%3A700002441872%3Aruntime%2FTripPlannerA2A_OrchestratorAgent-DZAPzV4CU4/invocations

# URL del API Gateway de reservas (output ReservationsApiUrl del CDK deploy)
VITE_RESERVATIONS_API_URL=https://<api-id>.execute-api.us-east-2.amazonaws.com

# AWS credenciales para firmar peticiones SigV4 al OrchestratorAgent
VITE_AWS_REGION=us-east-2
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_SESSION_TOKEN=

# ID de usuario por defecto (en producción esto viene de Cognito)
VITE_DEFAULT_USER_ID=default-user
