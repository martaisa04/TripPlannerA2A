# Copiar a .env.local y completar con los valores reales tras agentcore deploy

# URL del Lambda proxy SigV4 — output OrchestratorProxyUrl del CDK stack
# Formato: https://<api-id>.execute-api.us-east-2.amazonaws.com/invoke
VITE_PROXY_URL=https://<api-id>.execute-api.us-east-2.amazonaws.com/invoke

# URL base del API Gateway de reservas — output ReservationsApiUrl del CDK stack
VITE_RESERVATIONS_API_URL=https://<api-id>.execute-api.us-east-2.amazonaws.com

# Región AWS
VITE_AWS_REGION=us-east-2

# ID de usuario por defecto (en producción viene de Cognito u otro sistema de auth)
VITE_DEFAULT_USER_ID=default-user

# NOTA: No se requieren credenciales AWS en el frontend.
# La firma SigV4 se realiza server-side en el Lambda proxy.
